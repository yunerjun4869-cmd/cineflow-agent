# Copy to .env for docker compose (or export in your shell). Every variable is optional;
# values set here override backend/config.yaml at runtime and are never written to it.

# --- Model provider keys ---
SFA_DASHSCOPE_API_KEY=
SFA_ARK_API_KEY=
SFA_KLING_ACCESS_KEY=
SFA_KLING_SECRET_KEY=
SFA_OPENAI_API_KEY=
SFA_GEMINI_API_KEY=
SFA_DEEPSEEK_API_KEY=
# Any OpenAI-compatible endpoint (vLLM / Ollama / OpenRouter ...)
SFA_OPENAI_COMPATIBLE_API_KEY=
SFA_OPENAI_COMPATIBLE_BASE_URL=
# Outbound proxy for providers with enable_proxy: true
SFA_PROXY=

# --- Default models (ids from backend/registry/models.yaml) ---
# SFA_MODEL_LLM=qwen3.5-plus
# SFA_MODEL_VLM=qwen3.5-plus
# SFA_MODEL_IMAGE_T2I=doubao-seedream-5-0-260128
# SFA_MODEL_VIDEO_FIRST_FRAME=wan2.7-i2v

# --- Server ---
# SFA_HOST=127.0.0.1
# SFA_PORT=8000
# SFA_LOG_LEVEL=INFO
# 未指定场景时使用的场景包（backend/scenarios/ 下的目录名）
# SFA_DEFAULT_SCENARIO=short_film
# Extra allowed browser origins, comma separated
# SFA_CORS_ORIGINS=https://studio.example.com

# --- Docker compose only: URL the browser uses to reach the backend ---
# PUBLIC_BACKEND_URL=http://localhost:8000
